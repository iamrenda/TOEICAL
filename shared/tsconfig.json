{
    "compilerOptions": {
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "forceConsistentCasingInFileNames": true,

        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "esnext",

        "strict": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "skipLibCheck": true
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules"]
}
