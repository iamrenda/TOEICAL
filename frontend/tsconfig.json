{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "composite": true,
        "strict": true,
        "paths": {
            "@/*": ["./*"]
        }
    },
    "include": ["./**/*.ts", "./**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
    "exclude": ["node_modules"],
    "references": [{ "path": "../shared" }]
}
